{
  "redirects": [
    {
      "source": "/card",
      "destination": "/wallet",
      "permanent": true
    },
    {
      "source": "/card/",
      "destination": "/wallet",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/refund",
      "has": [
        {
          "type": "host",
          "value": "link.qat.com.tr"
        }
      ],
      "dest": "/link-refund.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}

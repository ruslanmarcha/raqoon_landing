# Production origin (no trailing slash). Used for canonical URLs, Open Graph images, and sitemap.xml at build time.
VITE_SITE_URL=https://raqoon.app

# Публичный FAQ Support API: origin, где реально отвечает JSON (без слэша в конце пути).
# Прод: `https://raqoon.qatlink.site/api/public` — ручки `GET /api/public/faq/...`.
# Не ставьте help.raqoon.app: Cloudflare отдаёт 301 на qatlink, и браузерный CORS-fetch падает.
# VITE_SUPPORT_PUBLIC_API_BASE=https://raqoon.qatlink.site/api/public
# Клиентский портал (кнопка «Профиль» в шапке)
# VITE_CLIENT_PORTAL_URL=https://raqoon.qatlink.site/support/login
# Стейдж/иной деплой — подставьте его origin + `/api/public` (не путать с tech VPN backend на *.izirocks.store).

# Google Analytics 4 (default in code: G-L4HJ702D14)
# VITE_GTAG_ID=G-L4HJ702D14

# Dev only: simulate EU visitor (consent banner). Set in .env.local
# VITE_DEV_FORCE_EU=1

# Turkey: when `true`, visitors with country TR see only /turkiye. Omit or set to anything else to disable.
# VITE_ENABLE_TURKEY_GEOLOCK=true

# Public eSIM pricing catalog (landing /esim).
# Default (browser): same-origin `/api/esim-pricing` → Vercel/Vite proxy to upstream
# (avoids CORS: backend allows https://raqoon.app only, not www/localhost).
# Optional override (direct upstream — only works from allowed CORS origins):
# VITE_ESIM_PRICING_URL=https://tech-raqoon-esim.izirocks.store/api/v1/public/pricing
# Server/proxy upstream override (Vercel env / Vite middleware):
# ESIM_PRICING_UPSTREAM_URL=https://tech-raqoon-esim.izirocks.store/api/v1/public/pricing

# POST JSON заявок бета-теста (см. docs/beta-google-apps-script.md). Пример: https://script.google.com/macros/s/.../exec
# VITE_BETA_WEBHOOK_URL=
